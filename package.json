{
  "name": "terax-ai-assistant",
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite -c vite.frontend.config.js --port 5173\" \"vite -c vite.admin.config.js --port 5174\"",
    "dev:admin": "vite -c vite.admin.config.js --port 5174",
    "dev:frontend": "vite -c vite.frontend.config.js --port 5173",
    "build": "vite build -c vite.frontend.config.js && vite build -c vite.admin.config.js",
    "format:check": "prettier --check src",
    "format:fix": "prettier --write src",
    "release": "npm run build && grunt release",
    "release:wporg": "npm run build && grunt release release-wporg",
    "release:pro": "grunt release-pro",
    "export:public": "bash scripts/export-public.sh",
    "version:bump": "node scripts/version.mjs bump",
    "version:check": "node scripts/version.mjs check",
    "i18n": "wp i18n make-pot . languages/terax-ai-assistant.pot --domain=terax-ai-assistant --exclude=node_modules,vendor,src,release",
    "i18n:check": "grunt i18n-check",
    "test:php": "npx --yes @wordpress/env@10 run tests-cli --env-cwd=wp-content/plugins/terax-ai-assistant vendor/bin/phpunit",
    "test:php:free": "npx --yes @wordpress/env@10 run tests-cli --env-cwd=wp-content/plugins/terax-ai-assistant env TERAX_TEST_NO_PRO=1 vendor/bin/phpunit --exclude-group pro",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js"
  },
  "devDependencies": {
    "@kucrut/vite-for-wp": "^0.7.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.2.22",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "grunt": "^1.6.1",
    "grunt-checktextdomain": "^1.0.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "load-grunt-tasks": "^5.1.0",
    "postcss": "^8.4.31",
    "postcss-preset-env": "^10.1.1",
    "prettier": "npm:wp-prettier@^3.0.3-beta-4",
    "prettier-plugin-tailwindcss": "^0.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup-plugin-external-globals": "^0.8.0",
    "tailwindcss": "^3.3.5",
    "vite": "^4.5.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.302.0",
    "preact": "^10.24.3",
    "react-router-dom": "^6.18.0",
    "recharts": "^2.12.7",
    "sonner": "^1.2.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
